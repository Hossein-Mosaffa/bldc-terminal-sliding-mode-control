      isEML		      1
      script		      "function y = fcn(va,vb,vc,ea,eb,ec,ia,ib,ic)\n\nRs = 1.2;        % Ohms, Terminal Resistance phas"
      "e to phase \nLs = 0.560e-3;   % Henrys, Terminal Inductance phase to phase \n\ndia = -(Rs/(Ls))*ia + (1/(Ls))*(v"
      "a - ea);\ndib = -(Rs/(Ls))*ib + (1/(Ls))*(vb - eb);\ndic = -(Rs/(Ls))*ic + (1/(Ls))*(vc - ec);\n\ny = [dia;dib;d"
      "ic];\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
