    superState		    SUBCHART
    subviewer		    17
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function y=emfg(u)\nvi=24;\nvh=vi/2;\nif(u>0)&&(u<=60)\n    y=[vi;vh;0];\nelseif(u>60)&&(u<=120)\n"
      "    y=[vh;vi;0];\nelseif(u>120)&&(u<=180)\n    y=[0;vi;vh];\nelseif (u>-180)&&(u<=-120)\n    y=[0;vh;vi];\nelsei"
      "f(u>-120)&&(u<=-60)\n    y=[vh;0;vi];\nelse\n    y=[vi;0;vh];\nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
